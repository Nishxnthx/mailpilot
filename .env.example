# MailPilot Environment Variable Template

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth 2.0 & Gmail API Credentials (Server-side ONLY)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_here

# AI Copilot Integration (OpenRouter OpenAI-Compatible API)
# Keep API keys strictly server-side
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Supabase PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgresql://postgres:password@localhost:5432/mailpilot
